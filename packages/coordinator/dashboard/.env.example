# Single coordinator fallback (still supported)
COORDINATOR_ID=main
COORDINATOR_LABEL=Main Coordinator
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bitblik
DB_USER=postgres
DB_PASSWORD=********

# Multi-coordinator mode overrides the single DB_* values above.
# JSON array with fields: id, label, iconUrl, host, port, database, user, password
# Quote whole value in .env files, especially when passwords contain #.
# COORDINATORS_JSON='[{"id":"main","label":"Main","iconUrl":"https://example.com/main.png","host":"localhost","port":5432,"database":"bitblik","user":"postgres","password":"secret"},{"id":"staging","label":"Staging","iconUrl":"https://example.com/staging.png","host":"localhost","port":5433,"database":"bitblik_staging","user":"postgres","password":"secret"}]'

# Optional: override the favicon in the served HTML (URL or path)
# DASHBOARD_FAVICON_URL=https://example.com/favicon.ico
