PAYMENT_SYSTEM=blik
FRONTEND_DOMAIN=bitblik.app
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
NOSTR_RELAYS=wss://relay.primal.net,wss://nos.lol,wss://nostr.mom,wss://relay.damus.io
STATE_FILE=./telegram_bot_state.json

# A second funded offer from one coordinator inside this window triggers the
# per-pubkey cooldown. The triggering offer and all offers during cooldown are
# suppressed; other coordinators remain unaffected.
COORDINATOR_MIN_OFFER_INTERVAL_SECONDS=10
COORDINATOR_RATE_LIMIT_SECONDS=600

# Discovery is intentionally infrequent and uncached to keep this daemon small.
DISCOVERY_REFRESH_SECONDS=300
NOSTR_QUERY_TIMEOUT_SECONDS=8
SUBSCRIPTION_OVERLAP_SECONDS=15
SUBSCRIPTION_ROTATION_SECONDS=900

# Bound persisted/in-memory offer history, including short-lived terminal
# tombstones retained to deduplicate overlapping subscription replays.
OFFER_STATE_RETENTION_SECONDS=172800
MAX_TRACKED_OFFERS=2000
